# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/matmap

# Server-restricted (IP-allowlisted) Google Maps key.
# Enable ONLY: Directions API, Geocoding API. Never ship this key to the frontend.
GOOGLE_MAPS_SERVER_KEY=

# Must match the frontend's origin so browser requests aren't blocked by CORS
CORS_ORIGIN=http://localhost:3000

# How long to cache Directions API responses, in milliseconds
DIRECTIONS_CACHE_TTL_MS=300000